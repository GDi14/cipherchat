rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Encrypted file blobs
    match /attachments/{fileId} {
      // Blobs are client-encrypted with AES-256-GCM before upload,
      // so the server has zero knowledge of contents, file names, or metadata.
      allow read, write: if true;
    }
  }
}
