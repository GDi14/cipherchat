rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public user directory and Signal prekey bundles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.resource.data.userId == userId;
    }

    // End-to-end encrypted messages
    match /messages/{messageId} {
      // Senders and recipients can read encrypted messages
      allow read: if resource.data.recipientId != null;
      
      // Allow sending messages
      allow create: if request.resource.data.senderId != null 
                    && request.resource.data.recipientId != null
                    && request.resource.data.encryptedPayload != null;
                    
      // Allow recipient or sender to update delivery/read status
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      
      allow delete: if false;
    }

    // Ephemeral typing indicators
    match /typing/{chatId} {
      allow read, write: if true;
    }
  }
}
